{
  "contract_version": "0.1.0",
  "study_id": "ecm_terafab_us_energy_security",
  "intended_journal": "Energy Conversion and Management",
  "status": "step_1_complete_pending_owner_approval",
  "primary_question": "Under transparent interpretations of the publicly announced Terafab production target, what semiconductor throughput and facility electricity, heat-rejection, water, and firm-supply requirements are implied, and under which 2026-2050 deployment and energy-supply pathways can those requirements be accommodated without violating defined ERCOT and United States electricity-security constraints?",
  "target_semantics": {
    "public_phrase": "Terafab output 1 TW/Year",
    "primary_interpretation": "aggregate rated electrical power embodied in good compute devices manufactured per calendar year",
    "primary_unit": "W_rated/year",
    "prohibited_equivalence": "The public 1 TW/year output target must never be assigned as a 1 TW facility electrical load.",
    "alternative_interpretation_required": true,
    "insufficient_semantics_outcome": "indeterminate"
  },
  "boundaries": {
    "start_year": 2026,
    "end_year": 2050,
    "primary_time_step": "annual",
    "secondary_time_step": "hourly_selected_years_if_authoritative_data_are_available",
    "facility_geography": "publicly reported Texas research and large-scale facilities",
    "regional_system": "ERCOT conditional on ERCOT interconnection",
    "national_system": "United States electricity system represented by EIA and NERC public projections",
    "functional_unit": "1 W_rated of good compute-device capacity manufactured per calendar year",
    "included": [
      "semiconductor throughput and yield",
      "process-tool electricity",
      "cleanroom and facility electricity",
      "cooling and heat rejection",
      "ultrapure water and wastewater",
      "advanced packaging and testing where publicly supportable",
      "onsite electricity generation and storage",
      "operational fuel use and emissions",
      "ERCOT and national counterfactual comparison"
    ],
    "excluded": [
      "electricity consumed by manufactured chips after deployment",
      "orbital data-center operation",
      "launch energy",
      "proprietary process recipes or schedules",
      "full macroeconomic equilibrium",
      "wholesale electricity price prediction",
      "investment valuation",
      "project finance",
      "unquantified semiconductor security benefits"
    ]
  },
